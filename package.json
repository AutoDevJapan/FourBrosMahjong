{
  "name": "soshina-majong",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "server:dev": "tsx watch server/start.ts",
    "server:start": "tsx server/start.ts",
    "verify:server:container": "node scripts/verify-online-container-signal.mjs",
    "verify:server:rollout-preflight": "tsx scripts/verify-online-rollout-preflight.ts",
    "verify:railway:iac-migration": "tsx scripts/verify-railway-iac-migration.ts",
    "validate:server:ops-token": "tsx scripts/validate-online-ops-token.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:node": "node scripts/check-node-version.mjs",
    "pretest": "node scripts/check-node-version.mjs",
    "test": "vitest run --maxWorkers=1",
    "pretest:unit": "node scripts/check-node-version.mjs",
    "test:unit": "vitest run --project unit",
    "pretest:component": "node scripts/check-node-version.mjs",
    "test:component": "vitest run --project component",
    "pretest:watch": "node scripts/check-node-version.mjs",
    "test:watch": "vitest",
    "pretest:coverage": "node scripts/check-node-version.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "E2E_PROD=1 playwright test e2e/pwa-offline.spec.ts",
    "test:e2e:pwa:prebuilt": "E2E_PROD=1 E2E_PROD_PREBUILT=1 playwright test e2e/pwa-offline.spec.ts",
    "test:e2e:prod:prebuilt": "E2E_PROD=1 E2E_PROD_PREBUILT=1 playwright test --project=chromium e2e/pwa-offline.spec.ts e2e/persistence.spec.ts e2e/modal-focus.spec.ts e2e/security-headers.spec.ts e2e/metadata.spec.ts e2e/a11y.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "depcruise": "depcruise src server",
    "docs": "typedoc"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4",
    "typedoc": "^0.28.20",
    "typescript": "^6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.0.0": "1.1.18",
      "brace-expansion@^5.0.0": "5.0.9",
      "postcss@^8.0.0": "8.5.25",
      "sharp": ">=0.35.3"
    }
  }
}
